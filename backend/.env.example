# LoanWise AI — Environment Variables Template
# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# ─── Database ──────────────────────────────────────────────────
# For MongoDB Atlas (production):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/loan_ai_system?retryWrites=true&w=majority

# For local MongoDB (development):
# MONGODB_URI=mongodb://localhost:27017

DATABASE_NAME=loan_ai_system

# ─── JWT Authentication ────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Application ──────────────────────────────────────────────
MODEL_PATH=ml/models/
APP_ENV=production
